# Baseline on Vercel: set these under Project → Settings → Environment Variables (all environments).
# Storage: connect a private Blob store to the project (Storage tab); that adds BLOB_READ_WRITE_TOKEN by itself.

APP_PASSWORD=            # the password you sign in with (8+ characters)
SESSION_SECRET=          # long random string (openssl rand -hex 32); change it to sign out every device
INGEST_TOKEN=            # long random string (openssl rand -hex 24) for the iPhone Shortcut and the import script

HACKCLUB_AI_KEY=         # https://ai.hackclub.com/dashboard — plan import and the coach's note
# HACKCLUB_AI_MODEL=anthropic/claude-haiku-5.5
# HACKCLUB_AI_FALLBACKS=openai/gpt-6-luna,google/gemini-2.5-flash

STRAVA_CLIENT_ID=         # your own Strava API app: https://www.strava.com/settings/api (callback domain = your Vercel host)
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=      # any random string (8+ characters) for the webhook subscription

# BASELINE_TZ=Europe/Berlin   # the day boundary used by the morning summary
# BLOB_PREFIX=baseline        # folder inside the Blob store
