{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/ingest.js": {
      "includeFiles": "public/js/**",
      "maxDuration": 30
    },
    "api/ai.js": {
      "maxDuration": 60
    }
  }
}
